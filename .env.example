# Agentic Inquiry Environment Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration (for test-postgresql.yaml)
# POSTGRES_USER=ai_test_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DATABASE=agentic-inquiry_test

# Storage Configuration
# INQUIRY_STORAGE_ROOT=./.agentic-inquiry
# INQUIRY_STORAGE_DEFAULT_PROJECT_ID=my_project

# Search Configuration
# INQUIRY_SEARCH_DEFAULT_LIMIT=10
# INQUIRY_SEARCH_HYBRID_SEARCH_VECTOR_WEIGHT=0.7
# INQUIRY_SEARCH_HYBRID_SEARCH_FTS_WEIGHT=0.3

# Embedding Configuration
# INQUIRY_EMBEDDINGS_DEFAULT_PROVIDER=sentence_transformer
# INQUIRY_EMBEDDINGS_DEFAULT_DIMENSIONS=384

# Logging Configuration
# INQUIRY_LOGGING_LEVEL=INFO
# INQUIRY_LOGGING_DIRECTORY=logs

# MCP Configuration
# INQUIRY_MCP_SERVER_NAME="Agentic Inquiry"
# INQUIRY_MCP_API_HOST=127.0.0.1
# INQUIRY_MCP_API_PORT=8765
