# Agentic Inquiry Environment Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration (for test-postgresql.yaml)
# POSTGRES_USER=ai_test_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DATABASE=agentic-inquiry_test

# Storage Configuration
# AI_STORAGE_ROOT=./.agentic-inquiry
# AI_STORAGE_DEFAULT_PROJECT_ID=my_project

# Search Configuration
# AI_SEARCH_DEFAULT_LIMIT=10
# AI_SEARCH_HYBRID_SEARCH_VECTOR_WEIGHT=0.7
# AI_SEARCH_HYBRID_SEARCH_FTS_WEIGHT=0.3

# Embedding Configuration
# AI_EMBEDDINGS_DEFAULT_PROVIDER=sentence_transformer
# AI_EMBEDDINGS_DEFAULT_DIMENSIONS=384

# Logging Configuration
# AI_LOGGING_LEVEL=INFO
# AI_LOGGING_DIRECTORY=logs

# MCP Configuration
# AI_MCP_SERVER_NAME="Agentic Inquiry"
# AI_MCP_API_HOST=127.0.0.1
# AI_MCP_API_PORT=8765
