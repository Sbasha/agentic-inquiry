# Agent-Vault Environment Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration (for test-postgresql.yaml)
# POSTGRES_USER=agv_test_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DATABASE=agent-vault_test

# Storage Configuration
# AGV_STORAGE_ROOT=./.agv
# AGV_STORAGE_DEFAULT_PROJECT_ID=my_project

# Search Configuration
# AGV_SEARCH_DEFAULT_LIMIT=10
# AGV_SEARCH_HYBRID_SEARCH_VECTOR_WEIGHT=0.7
# AGV_SEARCH_HYBRID_SEARCH_FTS_WEIGHT=0.3

# Embedding Configuration
# AGV_EMBEDDINGS_DEFAULT_PROVIDER=sentence_transformer
# AGV_EMBEDDINGS_DEFAULT_DIMENSIONS=384

# Logging Configuration
# AGV_LOGGING_LEVEL=INFO
# AGV_LOGGING_DIRECTORY=logs

# MCP Configuration
# AGV_MCP_SERVER_NAME="Agent-Vault"
# AGV_MCP_API_HOST=127.0.0.1
# AGV_MCP_API_PORT=8765
