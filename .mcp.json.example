{
  "mcpServers": {
    "ai-sse": {
      "url": "http://localhost:8765/sse"
    },
    "ai-test": {
      "command": "uv",
      "args": [
        "run",
        "ai",
        "--config", "config/test-lancedb.yaml",
        "--project-id", "test",
        "--transport", "stdio"
      ]
    },
    "ai-test-postgres": {
      "command": "uv",
      "args": [
        "run",
        "ai",
        "--config", "config/test-postgresql.yaml",
        "--project-id", "test",
        "--transport", "stdio"
      ],
      "env": {
        "CLOUDSQL_PROJECT": "${CLOUDSQL_PROJECT}",
        "CLOUDSQL_REGION": "${CLOUDSQL_REGION}",
        "CLOUDSQL_INSTANCE": "${CLOUDSQL_INSTANCE}",
        "CLOUDSQL_DATABASE": "${CLOUDSQL_DATABASE}",
        "CLOUDSQL_USER": "${CLOUDSQL_USER}"
      }
    }
  }
}
