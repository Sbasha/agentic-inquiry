{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LanceDB Backend Configuration",
    "description": "Configuration schema for LanceDB storage backend",
    "type": "object",
    "properties": {
        "type": {
            "const": "lancedb",
            "description": "Backend type identifier"
        },
        "database_path": {
            "type": "string",
            "description": "Path to LanceDB data directory",
            "minLength": 1
        },
        "table_prefix": {
            "type": "string",
            "description": "Prefix for table names (useful for multi-tenant deployments)",
            "pattern": "^[a-zA-Z0-9_]*$"
        }
    },
    "required": ["type", "database_path"],
    "additionalProperties": false
}
