{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PostgreSQL Backend Configuration",
    "description": "Configuration schema for PostgreSQL storage backend",
    "type": "object",
    "properties": {
        "type": {
            "const": "postgresql",
            "description": "Backend type identifier"
        },
        "connection_string": {
            "type": "string",
            "description": "PostgreSQL connection string (e.g., postgresql://user:pass@host:port/db). Supports environment variable expansion (${VAR_NAME})."
        },
        "pool_size": {
            "type": "integer",
            "description": "Base connection pool size",
            "minimum": 1,
            "maximum": 100,
            "default": 10
        },
        "min_pool_size": {
            "type": "integer",
            "description": "Minimum connections to keep alive",
            "minimum": 0,
            "maximum": 100,
            "default": 2
        },
        "max_overflow": {
            "type": "integer",
            "description": "Maximum pool overflow connections",
            "minimum": 0,
            "maximum": 50,
            "default": 5
        },
        "table_prefix": {
            "type": "string",
            "description": "Prefix for table names (useful for multi-tenant deployments)",
            "pattern": "^[a-zA-Z0-9_]*$"
        },
        "index_type": {
            "type": "string",
            "description": "Vector index type for similarity search",
            "enum": ["hnsw", "ivfflat", "none"],
            "default": "hnsw"
        },
        "index_params": {
            "type": "object",
            "description": "Index parameters (e.g., {\"m\": 16, \"ef_construction\": 64} for HNSW)",
            "additionalProperties": true
        },
        "expected_rows": {
            "type": "integer",
            "description": "Expected row count for IVFFlat lists calculation",
            "minimum": 1
        },
        "fts_language": {
            "type": "string",
            "description": "PostgreSQL full-text search language configuration",
            "default": "english"
        },
        "ssl_mode": {
            "type": "string",
            "description": "SSL mode for database connections",
            "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        },
        "ssl_ca_cert": {
            "type": "string",
            "description": "Path to CA certificate file (required for verify-full mode)"
        },
        "allow_direct_connection": {
            "type": "boolean",
            "description": "Allow direct connection without Cloud SQL Proxy",
            "default": false
        },
        "embedding_strategy": {
            "type": "string",
            "description": "Embedding generation strategy: local (client-side) or server_side (database-native)",
            "enum": ["local", "server_side"],
            "default": "local"
        },
        "embedding_model": {
            "type": "string",
            "description": "Server-side embedding model name (only used when embedding_strategy=server_side)"
        },
        "embedding_dim": {
            "type": "integer",
            "description": "Embedding vector dimensions (384 for local, 768 for server_side)",
            "minimum": 1
        },
        "user": {
            "type": "string",
            "description": "Database user (for GCP proxy connections)"
        },
        "password": {
            "type": "string",
            "description": "Database password (for GCP proxy connections)"
        },
        "port": {
            "type": "integer",
            "description": "Database port",
            "minimum": 1,
            "maximum": 65535,
            "default": 5432
        },
        "database": {
            "type": "string",
            "description": "Database name (for GCP proxy connections)"
        },
        "project": {
            "type": "string",
            "description": "GCP project ID (for cloud proxy connections)"
        },
        "region": {
            "type": "string",
            "description": "GCP region (for cloud proxy connections)"
        },
        "instance": {
            "type": "string",
            "description": "Cloud instance name (for cloud proxy connections)"
        },
        "cluster": {
            "type": "string",
            "description": "AlloyDB cluster name (for AlloyDB proxy connections)"
        },
        "ssl": {
            "type": "boolean",
            "description": "Whether to use SSL for proxy connections",
            "default": true
        }
    },
    "required": ["type"],
    "additionalProperties": false
}
