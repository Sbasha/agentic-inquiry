# Claude Code session/worktree artifacts: ignore everything under .claude
# by default, then re-include the committed agent-ready-repo artifacts.
# (Gitignore won't let us re-include children if the parent dir itself is
# excluded, so we use `.claude/*` instead of `.claude/`.)
# Commands/ and hooks/ are pre-positioned — empty today; the work-loop
# skill drops content into them as a project adopts hooks or slash
# commands, and we want those auto-tracked without re-editing this file.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/hooks/

# work-loop runtime state (per-session scratch — see docs/CONVENTIONS.md)
.ralph/
docs/specs/**/state.json
docs/specs/**/notes/implementer-*.md
.worktrees/

# File watcher database
.file_tracker.db
.file_tracker.db-journal
.file_tracker.db-wal
.file_tracker.db-shm

# cleanup
.ruff_cache/

# Configuration (per-developer customization)
agent-vault.yaml
.agv/
logs/

# Local embedding models (downloaded/converted models)
/models/
!agent-vault/mcp/models/
*.onnx
*.safetensors

# Example artifacts (should use temp directories)
example_*.lancedb/

.serena/
.uv-cache/
.uv_cache/

# OS files
**/.DS_Store
Thumbs.db

# Temporary scripts (developer scratch space)
.tmp_scripts/

# Test results (timestamped test outputs)
test_results/
# But keep golden data for regression testing
!test_results/**/golden_data/
!test_results/**/golden_data/*.json

# Work session artifacts (transient)
.sessions/

# Wicked-crew project tracking
.something-wicked/

# Credentials (never commit)
credentials*.json
*-credentials.json
service-account*.json

.cia*

